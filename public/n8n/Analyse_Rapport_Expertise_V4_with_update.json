    {
      "parameters": {
        "jsCode": "$input.first().json.repairsForDB = [];\n$input.first().json.partsForDB = [];\n\nvar sinister_date = $input.first().json.sinister.date\nvar report_date = $input.first().json.date\n\nvar dateReport =  report_date.split(\"/\").reverse().join(\"-\");\nvar dateSinister =  sinister_date.split(\"/\").reverse().join(\"-\");\nif((dateReport.split(\"-\")[0]).length == 2)\n  dateReport = \"20\"+dateReport;\nif((dateSinister.split(\"-\")[0]).length == 2)\n  dateSinister = \"20\"+dateSinister;\n\n$input.first().json.date = dateReport;\n$input.first().json.sinister.date = dateSinister;\n\nlet i = 0;\n\nfor (const item of $input.first().json.repairs) {\n  let repair = {};\n  repair.id = 'repair_' + Date.now() + i;\n  repair.description = item.label;\n  repair.quantity = parseFloat(item.quantity);\n  repair.unitCost = item.unitCost;\n  repair.discount = item.discount || 0;\n  repair.vat = item.tax;\n  repair.total = item.finalAmount;\n  $input.first().json.repairsForDB.push(repair);\n  i++;\n}\n\ni = 0;\n\nfor (const item of $input.first().json.parts) {\n  let part = {};\n  part.id = 'part_' + Date.now() + i;\n  part.description = item.label;\n  part.quantity = parseFloat(item.quantity);\n  part.unitCost = item.unitCost;\n  part.discount = item.discount;\n  part.vat = item.tax;\n  part.total = item.finalAmount;\n  $input.first().json.partsForDB.push(part);\n  i++;\n}\n\n$input.first().json.globalDiscountsForDB = [];\n\nlet j = 0;\n\nfor (const item of $input.first().json.globalDiscounts || []) {\n  let discount = {};\n  discount.id = 'discount_' + Date.now() + j;\n  discount.label = item.label;\n  discount.rate = item.rate;\n  discount.subAmount = item.subAmount;\n  discount.taxAmount = item.taxAmount;\n  discount.finalAmount = item.finalAmount;\n  \n  $input.first().json.globalDiscountsForDB.push(discount);\n  j++;\n}\n\n\n\nreturn $input.all();"
      },
