    {
      "parameters": {
        "jsCode": "function extractAddress(address) {\n    const match = address.match(/^(.*?)\\s(\\d{5})\\s([\\w\\s-]+)$/);\n    if (match) {\n        return {\n            address: match[1].trim(),\n            zipCode: match[2],\n            city: match[3].trim()\n        };\n    } else {\n        //throw new Error(\"Format d'adresse non reconnu.\");\n    }\n}\n\nlet client = {};\n// C'est une bonne pratique de ne récupérer la source qu'une seule fois\nconst sourceData = $('Merge with origin').first().json; \n\nclient.companyId = sourceData.companyId;\nlet names = sourceData.customer.name.split(' ');\nclient.lastName = names[0];\nclient.firstName = names[1];\n\nlet extractedAddress = extractAddress(sourceData.customer.address);\nif (extractedAddress) {\n  client.address = extractedAddress.address;\n  client.zipCode = extractedAddress.zipCode;\n  client.city = extractedAddress.city;  \n}\n\nclient.email = sourceData.customer.email;\n\n// --- Logique de normalisation du téléphone ---\nlet rawPhone = sourceData.customer.phone;\nlet formattedPhone = null; // Mettre null (ou \"\") si le numéro est invalide\n\nif (rawPhone) {\n    // 1. Supprime tous les caractères non numériques (espaces, +, °, ., -)\n    const digits = rawPhone.replace(/\\D/g, ''); \n\n    // 2. Vérifie qu'on a au moins 9 chiffres.\n    // (ex: 0612345678 -> 10 chiffres, 33612345678 -> 11 chiffres)\n    if (digits.length >= 9) {\n        // 3. Prend les 9 derniers chiffres\n        const last9Digits = digits.slice(-9); \n        \n        // 4. Ajoute le préfixe +33\n        formattedPhone = '+33' + last9Digits;\n    }\n}\n\nclient.phone = formattedPhone;\n// --- Fin de la logique téléphone ---\n\nreturn client;"
      },
